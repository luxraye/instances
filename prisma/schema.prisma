generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For production, change provider to "postgresql" and update DATABASE_URL.
  // Then run: npx prisma migrate deploy
  // See .env.example for the full connection string format.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  REVIEWER
  LICENSEE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum InstanceStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  FLAGGED
  REJECTED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Auth.js / NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(LICENSEE)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts Account[]
  sessions Session[]

  assignedInstances Instance[] @relation("AssigneeInstances")
  provisionedInstances Instance[] @relation("ProvisionerInstances")
  reviewedInstances Instance[] @relation("ReviewerInstances")
  auditLogs         AuditLog[]
  apiKeysCreated    ApiKey[] @relation("ApiKeyCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logoUrl      String?
  primaryColor String?
  status       TenantStatus @default(ACTIVE)

  users             User[]
  matrixDimensions  MatrixDimension[]
  templates         Template[]
  instances         Instance[]
  instanceFiles     InstanceFile[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatrixDimension {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int      @default(0)
  values    MatrixDimensionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model MatrixDimensionValue {
  id           String          @id @default(cuid())
  dimensionId  String
  dimension    MatrixDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  label        String
  code         String
  sortOrder    Int             @default(0)
  templateTags TemplateMatrixTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dimensionId, code])
  @@index([dimensionId])
}

model Template {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  schema      Json // { jsonSchema, fileSlots?: [...] }
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  publishedAt DateTime?

  matrixTags TemplateMatrixTag[]
  instances  Instance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code, version])
  @@index([tenantId])
}

model TemplateMatrixTag {
  templateId             String
  template               Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  matrixDimensionValueId String
  matrixDimensionValue   MatrixDimensionValue @relation(fields: [matrixDimensionValueId], references: [id], onDelete: Cascade)

  @@id([templateId, matrixDimensionValueId])
}

model Instance {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId       String
  template         Template       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assigneeId       String
  assignee         User           @relation("AssigneeInstances", fields: [assigneeId], references: [id], onDelete: Restrict)
  provisionedById  String
  provisionedBy    User           @relation("ProvisionerInstances", fields: [provisionedById], references: [id], onDelete: Restrict)
  status           InstanceStatus @default(PENDING)
  deadline         DateTime
  draftPayload     Json? // working copy (JSON object)
  submissionPayload Json? // locked on submit
  submissionJwt    String?
  reviewNotes      String?
  reviewedById     String?
  reviewedBy       User?          @relation("ReviewerInstances", fields: [reviewedById], references: [id])
  submittedAt      DateTime?
  reviewedAt       DateTime?

  files InstanceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([assigneeId])
  @@index([templateId])
}

model InstanceFile {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId    String
  instance      Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  slotKey       String
  fileName      String
  fileExtension String
  fileSize      Int
  clientHash    String
  serverHash    String
  storagePath   String
  uploadedAt    DateTime @default(now())

  @@index([instanceId])
  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  keyPrefix   String
  keyHash     String
  createdById String
  createdBy   User     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([keyPrefix])
}
