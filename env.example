# .env.example
# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: SQLite (no server needed)
DATABASE_URL="file:./dev.db"

# Production: change provider to "postgresql" in prisma/schema.prisma, then set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/instances?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-string"
SUBMISSION_JWT_SECRET="replace-with-another-random-string"

# ── App ───────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
DEFAULT_TENANT_SLUG="demo"

# ── File Storage ──────────────────────────────────────────────────────────────
# Local dev:
STORAGE_DRIVER="local"
UPLOAD_DIR=""

# Production (S3-compatible — AWS S3, Cloudflare R2, MinIO, etc.):
# STORAGE_DRIVER="s3"
# STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="bobs-instances"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_PUBLIC_URL=""
